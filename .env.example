# Local defaults for this Spring Boot + Spring Data JPA project (H2)
# Copy to .env only if your launch workflow loads dotenv files.
# Spring Boot itself reads these values from the process environment.
DB_URL=jdbc:h2:mem:urlshortener;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
APP_BASE_URL=http://localhost:8080